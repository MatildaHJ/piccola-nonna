---
import type { Location } from '../content/locations';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import Menu from './component-parts/Menu.astro';
import Hero from './component-parts/Hero.astro';
import LocationInfoCards from './component-parts/LocationInfoCards.astro';
import GoogleReviews from './GoogleReviews.astro';
import LocationMap from './LocationMap.astro';
import InstagramSection from './InstagramSection.astro';
import PressMentions from './PressMentions.astro';
interface Props {
  location: Location;
}
const { location } = Astro.props;
---

<div data-location-page-content>
  <Hero location={location} />
  <SiteHeader {location} />
  <main>
    <section
      id="menu-section"
      data-header-background-trigger
      class="bg-canvas py-16 sm:py-24"
      aria-labelledby="menu-heading"
    >
      <Menu location={location} />
    </section>
    <LocationInfoCards location={location} />
    {
      location.id === 'pizza' && (
        <>
          <GoogleReviews />
          <PressMentions />
        </>
      )
    }
    <InstagramSection {location} />
    <LocationMap {location} />
  </main>
  <SiteFooter {location} />
</div>
