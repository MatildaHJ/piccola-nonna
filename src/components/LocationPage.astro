---
import type { Location } from '../content/locations';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
interface Props {
  location: Location;
  showSelector?: boolean;
}
const { location, showSelector = false } = Astro.props;
---

{showSelector && <slot name="selector" />}
<div data-location-page-content>
  <SiteHeader {location} />
  <main>
    <section
      id={showSelector ? 'restaurant-content' : undefined}
      class="bg-canvas py-16 sm:py-24"
      aria-labelledby="menu-heading"
    >
      <div class="page-shell grid gap-12 lg:grid-cols-[0.55fr_1fr] lg:gap-20">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em]">
            På menyn
          </p><h2
            id="menu-heading"
            class="mt-4 font-display text-5xl leading-none sm:text-6xl"
          >
            Meny
          </h2>{
            location.menuStatus && (
              <p class="mt-6 text-lg">{location.menuStatus}</p>
            )
          }
        </div><div class="space-y-10">
          {
            location.menu.map((section) => (
              <section>
                <>
                  <h3 class="font-display text-3xl leading-none">
                    {section.title}
                  </h3>
                  <ul class="mt-5 divide-y divide-accent">
                    {section.items.map((item) => (
                      <li class="py-4 first:pt-0">
                        <p class="font-medium">{item.name}</p>
                        <p class="mt-1 text-sm leading-6 text-muted">
                          {item.description}
                        </p>
                      </li>
                    ))}
                  </ul>
                </>
              </section>
            ))
          }
        </div>
      </div>{
        location.notices && (
          <div class="page-shell mt-12 border-t border-accent pt-6">
            <ul class="space-y-2 text-sm text-muted">
              {location.notices.map((notice) => (
                <li>{notice}</li>
              ))}
            </ul>
          </div>
        )
      }
    </section>
  </main>
  <SiteFooter />
</div>
