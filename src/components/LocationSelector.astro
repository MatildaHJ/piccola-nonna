---
import { cafeLocation, pizzaLocation } from '../content/locations';
import ImageCard from './component-parts/ImageCard.astro';
import pizzaCardBg from '../images/location-pizza.png';
import cafeCardBg from '../images/location-cafe.png';
import pageBg from '../images/pizza/nonna-pizza5.png';

const imageSrc = pageBg.src;
---

<section
  data-location-selector
  class="bg-canvas text-white sticky top-0 z-50 flex min-h-svh w-full items-center justify-center gap-5 overflow-y-auto overflow-x-hidden px-5 sm:px-10"
  aria-label="Välj restaurang"
>
  <h1 class="sr-only">La piccola nonna</h1>
  <div class="page-shell flex items-center justify-center gap-12 max-h-[80vh]">
    <ImageCard
      location={pizzaLocation}
      logoSrc={pizzaLocation.assets.logo.src}
      imageSrc={pizzaCardBg.src}
      description="Södermalm"
    />
    <ImageCard
      location={cafeLocation}
      logoSrc={cafeLocation.assets.logo.src}
      imageSrc={cafeCardBg.src}
      description="Slakthusområdet"
    />
  </div>
</section>

<script>
  const selector = document.querySelector<HTMLElement>(
    '[data-location-selector]',
  );
  const pageContent = document.querySelector<HTMLElement>(
    '[data-location-page-content]',
  );

  if (selector && pageContent) {
    const choices = selector.querySelectorAll<HTMLAnchorElement>(
      '[data-location-choice]',
    );
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    );

    const animateExitAndScroll = () =>
      new Promise<void>((resolve) => {
        const duration = 640;
        const startTime = performance.now();
        const landingHeight = selector.getBoundingClientRect().height;

        const step = (currentTime: number) => {
          const progress = Math.min((currentTime - startTime) / duration, 1);
          const easedProgress = progress ** 1.3;

          const offset = -landingHeight * easedProgress;
          selector.style.transform = `translateY(${offset}px)`;
          pageContent.style.transform = `translateY(${offset}px)`;

          if (progress < 1) {
            window.requestAnimationFrame(step);
            return;
          }

          resolve();
        };

        window.requestAnimationFrame(step);
      });

    choices.forEach((choice) => {
      choice.addEventListener('click', async (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
          return;

        event.preventDefault();

        if (selector.dataset.transitioning === 'true') return;

        selector.dataset.transitioning = 'true';
        const destination = choice.dataset.locationChoice;
        const shouldReduceMotion = prefersReducedMotion.matches;

        if (shouldReduceMotion) {
          selector.hidden = true;
        } else {
          await animateExitAndScroll();
          selector.hidden = true;
          pageContent.style.transform = '';
        }

        document.body.classList.remove('overflow-hidden');

        if (destination === 'cafe') {
          window.location.assign(choice.href);
          return;
        }

        document
          .querySelectorAll<HTMLElement>('[data-site-logo], [data-location-nav]')
          .forEach((element) => {
            element.classList.remove('pointer-events-none', 'opacity-0');
          });
      });
    });
  }
</script>
