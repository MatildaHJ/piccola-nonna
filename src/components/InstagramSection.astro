---
import type { Location } from '../content/locations';
interface Props {
  location: Location;
}
const { location } = Astro.props;
---

<section
  class="border-t border-line py-16 sm:py-24"
  aria-labelledby="instagram-heading"
>
  <div
    class="page-shell flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
  >
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em]">
        Följ med
      </p><h2
        id="instagram-heading"
        class="mt-3 font-display text-5xl leading-none sm:text-6xl"
      >
        Instagram
      </h2>
    </div><a
      href={location.instagramUrl}
      target="_blank"
      rel="noreferrer"
      class="inline-flex w-fit rounded-full border border-ink px-5 py-3 text-sm font-medium transition-colors hover:border-accent hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >@{location.instagramHandle} <span aria-hidden="true">↗</span></a
    >
  </div>
</section>
