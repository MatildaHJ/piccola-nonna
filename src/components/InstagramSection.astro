---
import type { Location } from '../content/locations';
interface Props {
  location: Location;
}
const { location } = Astro.props;
---

<section class="py-16 sm:py-24" aria-labelledby="instagram-heading">
  <div
    class="container flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
  >
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">
        Följ oss på Instagram
      </p><h2
        id="instagram-heading"
        class="mt-3 font-display text-5xl leading-none sm:text-6xl"
      >
        <a
          href={location.instagramUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex gap-4 items-end transition-colors group
          focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >@{location.instagramHandle}
          <span
            aria-hidden="true"
            class="text-3xl pb-2 opacity-0 group-hover:opacity-100 trasition-opacity duration-(--base-duration) ease-(--standard-ease)"
            >↗</span
          ></a
        >
      </h2>
    </div>
  </div>
</section>
