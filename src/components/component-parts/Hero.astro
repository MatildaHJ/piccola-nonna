---
import { cafeLocation, pizzaLocation } from '../../content/locations';
import type { Location } from '../../content/locations';

interface Props {
  location: Location;
}

const { location } = Astro.props;
const alternateLocation =
  location.id === 'pizza' ? cafeLocation : pizzaLocation;
---

<section class="relative group w-screen h-svh md:h-vh">
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image: linear-gradient(rgb(18 23 28 / 25%), rgb(18 23 28 / 90%)), url(${location.assets.hero.src})`}
  >
  </div>
  <div
    class="page-shell h-full flex flex-col items-center justify-center gap-9"
  >
    <h1 class="sr-only">
      {location.name}
    </h1>
    <img
      src={location.assets.logo.src}
      alt=""
      class="h-60 w-60 md:w-85 md:h-85 z-30"
      aria-hidden="true"
    />
    <p class="z-30 font-light text-lg md:text-xl max-w-150 text-center">
      {location.assets.heroText}
    </p>
    <div class="flex gap-4">
      <button class="button button--transparent text-sm md:text-base z-30"
        >Meny</button
      >
      <a
        href={alternateLocation.route}
        class="button button--pink text-sm md:text-base z-30"
        >La Piccola Nonna {alternateLocation.shortName}
        <span class="button__arrow" aria-hidden="true">→</span></a
      >
    </div>
  </div>
</section>
