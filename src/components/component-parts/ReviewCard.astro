---
interface Props {
  text?: string;
  author?: string;
  published?: string;
  active?: boolean;
}

const { text = '', author = '', published = '', active = false } = Astro.props;
---

<article
  data-google-review-slide
  aria-hidden={active ? 'false' : 'true'}
  class="min-h-40 w-full shrink-0 p-4 sm:p-6 text-center"
>
  <p
    data-review-text
    class="mt-4 line-clamp-4 text-lg leading-7 md:text-xl md:leading-8"
  >
    {text}
  </p>
  <div
    class="mt-2 text-xs md:text-sm text-muted uppercase flex gap-2 justify-center"
  >
    <p class="font-medium">
      <a
        data-review-author
        class="focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
        >{author}</a
      >
    </p>
    <span data-review-date-separator aria-hidden="true">·</span>
    <p data-review-published>{published}</p>
  </div>
  <button
    type="button"
    data-review-expand
    hidden
    aria-expanded="false"
    class="mt-3 cursor-pointer text-sm text-primary underline underline-offset-4 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    >Läs mer</button
  >
</article>
