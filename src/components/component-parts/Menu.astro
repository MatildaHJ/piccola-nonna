---
import type { Location } from '../../content/locations';
import { ChevronDown } from '@lucide/astro';

interface Props {
  location: Location;
}
const { location } = Astro.props;
---

<div class="container">
  <div class="mx-auto flex max-w-[80vw] flex-col p-4 md:p-8">
    <div
      class="flex flex-col justify-between items-start gap-6 mb-12 md:flex-row md:items-end md:mb-20"
    >
      <div class="flex flex-col gap-2">
        <h2
          id="menu-heading"
          class="text-5xl md:text-6xl leading-none font-display text-primary"
        >
          Menyn
        </h2>
      </div>
      <div
        class="flex min-w-0 flex-col items-start gap-1 text-left md:items-end md:text-right"
      >
        {
          location.veganNote && (
            <div data-vegan-info class="relative w-full max-w-lg text-sm">
              <div class="flex flex-wrap items-center gap-x-2 gap-y-2 md:justify-end">
                <p class="text-muted">{location.veganNote}</p>
                <button
                  type="button"
                  data-vegan-info-toggle
                  aria-expanded="false"
                  aria-controls="vegan-cheese-info"
                  class="vegan-info-toggle inline-flex items-center gap-1 text-white font-light! hover:underline underline-offset-2 cursor-pointer"
                >
                  Läs mer
                  <ChevronDown size={14} aria-hidden="true" />
                </button>
              </div>
              <div
                id="vegan-cheese-info"
                data-vegan-info-panel
                class="vegan-info-panel absolute inset-x-0 top-full z-20"
                aria-hidden="true"
                inert
              >
                <div class="min-h-0 overflow-hidden">
                  <div class="mt-4 rounded-2xl border border-primary/20 bg-canvas bg-linear-to-r from-primary/5 to-primary/5 p-5 text-left leading-6 shadow-xl">
                    <p class="mb-3 text-xs uppercase tracking-wider text-muted">
                      Mer om våra veganska ostar
                    </p>
                    <h3 class="font-medium text-primary">
                      Vegansk fior di latte
                    </h3>
                    <p class="mt-1 text-muted">
                      Här kommer mer information om vår veganska fior di latte
                      och dess smak.
                    </p>
                    <h3 class="mt-4 font-medium text-primary">
                      Vegansk pecorino
                    </h3>
                    <p class="mt-1 text-muted">
                      Här kommer mer information om vår veganska pecorino och
                      dess karaktär.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          )
        }
      </div>
    </div>

    <div class="relative">
      <div
        aria-hidden="true"
        class="absolute inset-y-0 left-1/2 hidden -translate-x-1/2 flex-col items-center md:flex"
      >
        <span class="w-px flex-1 bg-primary"></span>
        <span
          class="my-6 size-10 shrink-0 rounded-full bg-primary text-canvas flex items-center justify-center"
          >✦</span
        >
        <span class="w-px flex-1 bg-primary"></span>
      </div>
      <div class="grid gap-10 md:grid-cols-2 md:gap-20">
        {
          location.menu.map((section, index) => (
            <section class="flex flex-col md:even:pl-10">
              <h3 class="font-display text-3xl md:text-4xl leading-none text-primary">
                {section.title}
              </h3>
              <ul class="mt-5">
                {section.items.map((item) => (
                  <li class="py-4 first:pt-0">
                    <p class="font-medium text-lg md:text-xl">{item.name}</p>
                    <p class="mt-1 text-sm leading-6 text-muted">
                      {item.description}
                    </p>
                  </li>
                ))}
              </ul>
              {index === 0 && location.dessert && (
                <div class="mt-auto pt-12">
                  <h3 class="font-display text-3xl md:text-4xl leading-none text-primary">
                    Dolce
                  </h3>
                  <p class="mt-5 font-medium text-lg md:text-xl">
                    {location.dessert.name}
                    {location.dessert.note && (
                      <span class="ml-1 text-sm font-normal text-muted">
                        ({location.dessert.note})
                      </span>
                    )}
                  </p>
                </div>
              )}
            </section>
          ))
        }
      </div>
    </div>

    {
      location.notices && (
        <div class="mt-12 pt-6">
          <ul class="space-y-2 text-sm text-muted/80">
            {location.notices.map((notice) => (
              <li class="italic">{notice}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-vegan-info]')
    .forEach((info) => {
      const toggle = info.querySelector<HTMLButtonElement>(
        '[data-vegan-info-toggle]',
      );
      const panel = info.querySelector<HTMLElement>('[data-vegan-info-panel]');
      if (!toggle || !panel) return;

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(expanded));
        panel.setAttribute('aria-hidden', String(!expanded));
        panel.inert = !expanded;
      });
    });
</script>

<style>
  .vegan-info-toggle svg {
    transition: transform var(--base-duration) var(--standard-ease);
  }

  .vegan-info-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .vegan-info-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows var(--base-duration) var(--standard-ease),
      opacity var(--base-duration) var(--standard-ease);
  }

  .vegan-info-panel[aria-hidden='false'] {
    grid-template-rows: 1fr;
    opacity: 1;
  }
</style>
