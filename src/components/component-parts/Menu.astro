---
import type { Location } from '../../content/locations';

interface Props {
  location: Location;
}
const { location } = Astro.props;
---

<div class="container">
  <div class="mx-auto flex max-w-[80vw] flex-col p-4 md:p-8">
    <div class="flex justify-between items-end mb-12 md:mb-20">
      <div class="flex flex-col gap-2">
        {
          location.menuNote && (
            <p class="text-[10px] md:text-xs tracking-wider uppercase">
              {location.menuNote}
            </p>
          )
        }
        <h2
          id="menu-heading"
          class="text-5xl md:text-6xl leading-none font-display text-primary"
        >
          Menyn
        </h2>
      </div>
      <div class="flex flex-col items-end gap-1 text-right">
        {
          location.menuStatus && (
            <p class="flex items-center gap-2 text-sm text-muted">
              <span
                aria-hidden="true"
                class="mb-0.5 h-3 w-3 rounded-[3px] bg-accent"
              />
              {location.menuStatus}
            </p>
          )
        }
      </div>
    </div>
    <div class="relative">
      <div
        aria-hidden="true"
        class="absolute inset-y-0 left-1/2 hidden -translate-x-1/2 flex-col items-center md:flex"
      >
        <span class="w-px flex-1 bg-primary"></span>
        <span
          class="my-6 size-10 shrink-0 rounded-full bg-primary text-[#2F4858] flex items-center justify-center"
          >✦</span
        >
        <span class="w-px flex-1 bg-primary"></span>
      </div>
      <div class="grid gap-10 md:grid-cols-2 md:gap-20">
        {
          location.menu.map((section) => (
            <section>
              <h3 class="font-display text-3xl md:text-4xl leading-none text-primary">
                {section.title}
              </h3>
              <ul class="mt-5">
                {section.items.map((item) => (
                  <li class="py-4 first:pt-0">
                    <p class="font-medium text-lg md:text-xl">{item.name}</p>
                    <p class="mt-1 text-sm leading-6 text-muted">
                      {item.description}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>

    {
      location.notices && (
        <div class="mt-12 pt-6">
          <ul class="space-y-2 text-sm text-muted/80">
            {location.notices.map((notice) => (
              <li class="italic">{notice}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</div>
