---
import type { Location } from '../../content/locations';
import { MapPin, ChevronDown } from '@lucide/astro';

interface Props {
  location: Location;
  logoSrc: string;
  imageSrc: string;
  heading?: string;
  description: string;
}
const { location, logoSrc, imageSrc, heading, description } = Astro.props;
---

<a
  href={location.route}
  data-location-choice={location.id}
  class="group relative block aspect-4/5 w-92 overflow-hidden bg-accent rounded-lg shadow-lg
    focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
>
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image: linear-gradient(rgb(0 0 0 / 25%), rgb(0 0 0 / 90%)), url(${imageSrc})`}
  >
  </div>
  <div
    class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-(--base-duration) ease-(--standard-ease) group-hover:opacity-100"
  >
  </div>
  <div
    class="relative flex h-full flex-col items-center justify-end p-6 text-white gap-2"
  >
    <img src={logoSrc} alt="" class="max-h-30 w-30" />
    {
      heading && (
        <h2 class="font-display text-4xl uppercase leading-none">{heading}</h2>
      )
    }
    <span class="flex items-center gap-1 text-xs uppercase mt-1"
      ><MapPin size={12} stroke-width={1.5} aria-hidden="true" />{
        description
      }</span
    >
    <div
      class="max-h-0 overflow-hidden opacity-0 transition-all duration-(--base-duration) ease-(--standard-ease) group-hover:max-h-12 group-hover:opacity-100"
    >
      <ChevronDown
        size={34}
        stroke-width={1.5}
        aria-hidden="true"
        class="group-hover:animate-chevron-bounce motion-reduce:group-hover:animate-none"
      />
    </div>
  </div>
</a>
