---
import type { Location } from '../content/locations';
interface Props {
  location: Location;
}
const { location } = Astro.props;
---

<section
  class="relative z-10 mx-auto -mb-16 w-[min(100%-2rem,75rem)] bg-sand p-6 text-ink shadow-[var(--soft-shadow)] sm:-mb-20 sm:p-10"
>
  <p class="text-xs font-semibold uppercase tracking-[0.16em]">Hitta hit</p><div
    class="mt-4 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"
  >
    <address class="not-italic">
      <p class="font-display text-3xl leading-none">{location.address}</p><p
        class="mt-2 text-sm"
      >
        {location.locality}
      </p>
    </address><a
      href={location.mapUrl}
      target="_blank"
      rel="noreferrer"
      class="inline-flex w-fit rounded-full bg-dark px-5 py-3 text-sm font-medium text-sand transition-colors hover:bg-accent hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-dark"
      >Öppna vägbeskrivning <span aria-hidden="true">↗</span></a
    >
  </div>
</section>
