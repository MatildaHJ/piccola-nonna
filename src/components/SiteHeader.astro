---
import type { Location } from '../content/locations';
interface Props {
  location?: Location;
}
const { location } = Astro.props;
const menuId = `site-menu-${location?.id ?? 'landing'}`;
---

<header
  data-site-header
  class="bg-canvas/80 text-white fixed top-0 z-40 w-full"
>
  <div class="relative w-full container">
    <div class="w-full flex items-center justify-between gap-4 py-4">
      <div>
        <button
          type="button"
          aria-label="Navigeringsmeny"
          aria-controls={menuId}
          aria-expanded="false"
          data-menu-toggle
          class="group relative z-70 h-6 w-6 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
        >
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-1 h-px bg-current transition-transform duration-(--base-duration) ease-(--standard-ease) group-[.is-open]:translate-y-2 group-[.is-open]:rotate-45"
          ></span>
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-current transition-opacity duration-(--base-duration) ease-(--standard-ease) group-[.is-open]:opacity-0"
          ></span>
          <span
            aria-hidden="true"
            class="absolute inset-x-0 bottom-1 h-px bg-current transition-transform duration-(--base-duration) ease-(--standard-ease) group-[.is-open]:-translate-y-2 group-[.is-open]:-rotate-45"
          ></span>
        </button>

        <nav
          id={menuId}
          aria-label="Navigering"
          aria-hidden="true"
          data-site-menu
          class="fixed inset-y-0 left-0 z-60 flex h-svh w-[min(22rem,85vw)] -translate-x-full flex-col bg-black/60 p-5 text-white shadow-2xl transition-transform duration-(--base-duration) ease-(--standard-ease) sm:p-8"
        >
          <ul class="mt-16 flex flex-col gap-6 text-3xl font-display uppercase">
            <li>
              <a
                href="/"
                class="transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                >Meny</a
              >
            </li>
            <li>
              <a
                href="/"
                class="transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                >Öppettider</a
              >
            </li>
            <li>
              <a
                href="/"
                class="transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                >Om oss</a
              >
            </li>
          </ul>
        </nav>
      </div>
      <div class="flex items-center gap-8 md:gap-10">
        <nav
          aria-label="Välj restaurang"
          data-location-nav
          class="transition-opacity"
        >
          <div
            class="relative grid w-40 grid-cols-2 rounded-full bg-white/15 p-1 text-xs font-medium"
          >
            <span
              aria-hidden="true"
              class=`pointer-events-none absolute inset-y-1 left-1 w-[calc(50%-0.25rem)] rounded-full bg-primary transition-transform duration-(--base-duration) ease-(--standard-ease) ${location?.id === 'cafe' ? 'translate-x-full' : 'translate-x-0'}`
            ></span>
            <a
              href="/"
              aria-current={location?.id === 'pizza' ? 'page' : undefined}
              class=`relative z-10 rounded-full px-2 py-1.5 text-center transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary ${location?.id === 'pizza' ? 'text-canvas' : 'text-white hover:text-primary'}`
              >Pizzeria</a
            >
            <a
              href="/cafe"
              aria-current={location?.id === 'cafe' ? 'page' : undefined}
              class=`relative z-10 rounded-full px-2 py-1.5 text-center transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary ${location?.id === 'cafe' ? 'text-canvas' : 'text-white hover:text-primary'}`
              >Café</a
            >
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-site-header]')
    .forEach((header) => {
      const toggle =
        header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = header.querySelector<HTMLElement>('[data-site-menu]');
      if (!toggle || !menu) return;

      const setMenuOpen = (isOpen: boolean) => {
        menu.classList.toggle('-translate-x-full', !isOpen);
        menu.setAttribute('aria-hidden', String(!isOpen));
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.setAttribute(
          'aria-label',
          isOpen ? 'Stäng navigeringsmeny' : 'Navigeringsmeny',
        );
        toggle.classList.toggle('is-open', isOpen);
      };

      toggle.addEventListener('click', () => {
        setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });

      window.addEventListener('keydown', (event) => {
        if (
          event.key === 'Escape' &&
          toggle.getAttribute('aria-expanded') === 'true'
        ) {
          setMenuOpen(false);
        }
      });
    });
</script>
