---
import type { Location } from '../content/locations';
import { Coffee, Pizza } from '@lucide/astro';
import SiteNavigation from './SiteNavigation.astro';
interface Props {
  location?: Location;
}
const { location } = Astro.props;
---

<header
  data-site-header
  class="fixed top-0 z-40 w-full bg-transparent text-white transition-colors duration-(--base-duration) ease-(--standard-ease)"
>
  <div class="relative w-full container">
    <div class="w-full flex items-center justify-between gap-4 py-4">
      <SiteNavigation {location} />
      <div class="flex items-center gap-8 md:gap-10">
        <nav
          aria-label="Välj restaurang"
          data-location-nav
          class="transition-opacity"
        >
          <a
            href={location?.id === 'cafe' ? '/' : '/cafe'}
            aria-label={location?.id === 'cafe'
              ? 'Byt till Pizzeria'
              : 'Byt till Café'}
            data-location-toggle
            class="relative grid w-48 grid-cols-2 rounded-full bg-canvas/70 p-1 text-[13px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >
            <span
              aria-hidden="true"
              class=`pointer-events-none absolute inset-y-1 left-1 w-[calc(50%-0.25rem)] rounded-full bg-text/40 transition-transform duration-(--base-duration) ease-(--standard-ease)
              ${location?.id === 'cafe' ? 'translate-x-full' : 'translate-x-0'}`
            ></span>
            <span
              data-location-option
              data-current-location={location?.id !== 'cafe'}
              class="relative z-10 flex items-center justify-center gap-1.5 rounded-full px-2 py-1 transition-colors"
            >
              <Pizza size={14} aria-hidden="true" class="shrink-0" />
              Pizza
            </span>
            <span
              data-location-option
              data-current-location={location?.id === 'cafe'}
              class="relative z-10 flex items-center justify-center gap-1.5 rounded-full px-2 py-1 transition-colors"
            >
              <Coffee size={14} aria-hidden="true" class="shrink-0" />
              Café
            </span>
          </a>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-site-header]')
    .forEach((header) => {
      const locationToggle = header.querySelector<HTMLElement>(
        '[data-location-toggle]',
      );
      const locationOptions = header.querySelectorAll<HTMLElement>(
        '[data-location-option]',
      );

      const backgroundTrigger = document.querySelector<HTMLElement>(
        '[data-header-background-trigger]',
      );

      const updateBackground = () => {
        if (!backgroundTrigger) return;

        const hasReachedMenu =
          backgroundTrigger.getBoundingClientRect().top <= header.offsetHeight;

        header.classList.toggle('bg-canvas/80', hasReachedMenu);
        header.classList.toggle('bg-transparent', !hasReachedMenu);
        locationToggle?.classList.toggle('bg-text/20', hasReachedMenu);
        locationToggle?.classList.toggle('bg-canvas/70', !hasReachedMenu);
        locationOptions.forEach((option) => {
          const isCurrentLocation = option.dataset.currentLocation === 'true';
          option.classList.toggle(
            'text-text',
            hasReachedMenu || isCurrentLocation,
          );
          option.classList.toggle('text-text/80', !isCurrentLocation);
        });
      };

      updateBackground();
      window.addEventListener('scroll', updateBackground, { passive: true });
      window.addEventListener('resize', updateBackground);
    });
</script>
