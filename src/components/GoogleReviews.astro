---
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import ReviewCard from './component-parts/ReviewCard.astro';
import pizzaBackground from '../images/pizza/pizza-bg.png';

// Shown only locally, allowing the layout to be styled without Google credentials.
const placeholderReviews = [
  {
    author: 'Sofia Lind',
    rating: 5,
    text: 'Otroligt god pizza, varm service och en så mysig liten restaurang. Vi kommer definitivt tillbaka!',
    relativePublishTimeDescription: 'för 2 veckor sedan',
  },
  {
    author: 'Erik Andersson',
    rating: 5,
    text: 'Den bästa napolitanska pizzan vi har ätit i Stockholm. Deg, råvaror och personal – allt satt perfekt.',
    relativePublishTimeDescription: 'för en månad sedan',
  },
  {
    author: 'Maja Karlsson',
    rating: 5,
    text: 'En riktig kvartersfavorit. Härlig stämning, fina smaker och alltid ett väldigt varmt välkomnande.',
    relativePublishTimeDescription: 'för 2 månader sedan',
  },
];

const isDevelopment = import.meta.env.DEV;
---

<section
  hidden={!isDevelopment}
  data-google-reviews
  data-review-background-width={pizzaBackground.width}
  data-review-background-height={pizzaBackground.height}
  class="relative isolate overflow-hidden py-16 sm:py-24"
  aria-labelledby="google-reviews-heading"
  style={`--reviews-background-position-y: 0px; background-image: url(${pizzaBackground.src}); background-position: center var(--reviews-background-position-y); background-size: cover;`}
>
  <div class="absolute inset-0 z-0 bg-canvas/90" aria-hidden="true"></div>
  <div class="container relative z-10 text-center">
    <div class="flex flex-col items-center gap-5">
      <div>
        <p
          class="text-xs font-semibold uppercase tracking-[0.16em] text-primary"
        >
          Älskad av pizzaälskare
        </p>
        <h2
          id="google-reviews-heading"
          class="mt-3 font-display text-5xl md:text-7xl leading-none flex gap-4 items-end"
        >
          <span data-google-reviews-rating>{isDevelopment ? '4.8' : ''}</span>
          <span class="text-lg md:text-xl text-[#C9A14B] pb-1"
            >★★★★★
            <span data-google-reviews-count class="block text-text"
              >{isDevelopment ? '766 recensioner' : ''}</span
            >
          </span>
        </h2>
      </div>
    </div>

    <div
      class="mx-auto mt-10 grid max-w-3xl grid-cols-[2.5rem_minmax(0,1fr)_2.5rem] items-center gap-x-1 sm:gap-x-4"
      data-google-reviews-carousel
    >
      <button
        type="button"
        data-google-reviews-previous
        class="review-arrow grid size-10 cursor-pointer place-items-center rounded-full text-primary
        focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
        aria-label="Visa föregående recension"
      >
        <ChevronLeft size={28} stroke-width={1.5} aria-hidden="true" />
      </button>
      <div class="overflow-hidden">
        <div
          data-google-reviews-list
          aria-live="polite"
          class="flex will-change-transform transition-transform duration-500 ease-(--standard-ease)"
        >
          {
            isDevelopment &&
              placeholderReviews.map((review, index) => (
                <ReviewCard
                  text={review.text}
                  author={review.author}
                  published={review.relativePublishTimeDescription}
                  active={index === 0}
                />
              ))
          }
        </div>
      </div>

      <button
        type="button"
        data-google-reviews-next
        class="review-arrow grid size-10 cursor-pointer place-items-center rounded-full text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
        aria-label="Visa nästa recension"
      >
        <ChevronRight size={28} stroke-width={1.5} aria-hidden="true" />
      </button>
      <div class="col-start-2 mt-6 flex items-center justify-center">
        <div
          class="flex items-center gap-2"
          data-google-reviews-dots
          aria-label="Välj recension"
        >
          {
            isDevelopment &&
              placeholderReviews.map((_, index) => (
                <button
                  type="button"
                  data-google-reviews-dot
                  data-index={index}
                  class:list={[
                    'size-2 rounded-full bg-white/40 transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary',
                    { 'bg-accent': index === 0 },
                  ]}
                  aria-label={`Visa recension ${index + 1}`}
                  aria-current={index === 0 ? 'true' : undefined}
                />
              ))
          }
        </div>
      </div>
    </div>
  </div>
  <template data-google-review-template>
    <ReviewCard />
  </template>
</section>

<script>
  type GoogleReview = {
    rating?: number;
    text?: string;
    relativePublishTimeDescription?: string;
    author?: { displayName?: string; uri?: string; photoUri?: string };
  };

  type GoogleReviewsResponse = {
    rating?: number;
    userRatingCount?: number;
    reviews: GoogleReview[];
  };

  const section = document.querySelector<HTMLElement>('[data-google-reviews]');
  const list = document.querySelector<HTMLElement>(
    '[data-google-reviews-list]',
  );
  const rating = document.querySelector<HTMLElement>(
    '[data-google-reviews-rating]',
  );
  const reviewCount = document.querySelector<HTMLElement>(
    '[data-google-reviews-count]',
  );
  const reviewTemplate = document.querySelector<HTMLTemplateElement>(
    '[data-google-review-template]',
  );
  const dots = document.querySelector<HTMLElement>(
    '[data-google-reviews-dots]',
  );
  const previous = document.querySelector<HTMLButtonElement>(
    '[data-google-reviews-previous]',
  );
  const next = document.querySelector<HTMLButtonElement>(
    '[data-google-reviews-next]',
  );
  let activeIndex = 0;

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let parallaxFrame: number | undefined;

  const updateParallax = () => {
    if (!section || reducedMotion.matches) return;

    const imageWidth = Number(section.dataset.reviewBackgroundWidth);
    const imageHeight = Number(section.dataset.reviewBackgroundHeight);
    if (!imageWidth || !imageHeight) return;

    const sectionBounds = section.getBoundingClientRect();
    const imageAspectRatio = imageWidth / imageHeight;
    const renderedImageHeight = Math.max(
      section.clientHeight,
      section.clientWidth / imageAspectRatio,
    );
    const maximumOffset = renderedImageHeight - section.clientHeight;
    const parallaxStart = window.innerHeight * 0.2;
    const scrollProgress = Math.min(
      1,
      Math.max(0, (parallaxStart - sectionBounds.top) / parallaxStart),
    );

    section.style.setProperty(
      '--reviews-background-position-y',
      `${-maximumOffset * scrollProgress}px`,
    );
  };

  const requestParallaxUpdate = () => {
    if (parallaxFrame) return;
    parallaxFrame = window.requestAnimationFrame(() => {
      updateParallax();
      parallaxFrame = undefined;
    });
  };

  requestParallaxUpdate();
  window.addEventListener('scroll', requestParallaxUpdate, { passive: true });
  window.addEventListener('resize', requestParallaxUpdate);

  const getSlides = () =>
    Array.from(
      list?.querySelectorAll<HTMLElement>('[data-google-review-slide]') ?? [],
    );

  const updateExpandButtons = () => {
    getSlides().forEach((slide) => {
      const text = slide.querySelector<HTMLElement>('[data-review-text]');
      const button = slide.querySelector<HTMLButtonElement>(
        '[data-review-expand]',
      );
      if (!text || !button || button.getAttribute('aria-expanded') === 'true')
        return;
      button.hidden = text.scrollHeight <= text.clientHeight + 1;
    });
  };

  window.addEventListener('resize', updateExpandButtons);
  void document.fonts.ready.then(updateExpandButtons);
  list?.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>(
      '[data-review-expand]',
    );
    const text = button
      ?.closest('article')
      ?.querySelector<HTMLElement>('[data-review-text]');
    if (!button || !text) return;
    const expanded = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(expanded));
    button.textContent = expanded ? 'Visa mindre' : 'Läs mer';
    text.classList.toggle('line-clamp-4', !expanded);
    requestParallaxUpdate();
  });

  const showSlide = (index: number) => {
    const slides = getSlides();
    if (!slides.length) return;
    activeIndex = (index + slides.length) % slides.length;
    slides.forEach((slide, slideIndex) => {
      const isActive = slideIndex === activeIndex;
      slide.setAttribute('aria-hidden', String(!isActive));
      slide.inert = !isActive;
      slide.querySelector('[data-review-text]')?.classList.add('line-clamp-4');
      const button = slide.querySelector<HTMLButtonElement>(
        '[data-review-expand]',
      );
      if (button) {
        button.setAttribute('aria-expanded', 'false');
        button.textContent = 'Läs mer';
      }
    });
    window.requestAnimationFrame(updateExpandButtons);
    requestParallaxUpdate();
    if (list) list.style.transform = `translateX(-${activeIndex * 100}%)`;
    dots
      ?.querySelectorAll<HTMLButtonElement>('[data-google-reviews-dot]')
      .forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex;
        dot.classList.toggle('bg-accent', isActive);
        dot.classList.toggle('bg-white/40', !isActive);
        dot.setAttribute('aria-current', String(isActive));
      });
  };

  const createReviewCard = (review: GoogleReview) => {
    const article = reviewTemplate!.content.firstElementChild!.cloneNode(
      true,
    ) as HTMLElement;
    const text = article.querySelector<HTMLElement>('[data-review-text]')!;
    text.textContent = review.text ?? '';
    text.hidden = !review.text;

    const author = article.querySelector<HTMLAnchorElement>(
      '[data-review-author]',
    )!;
    author.textContent = review.author?.displayName ?? 'Google-användare';
    if (review.author?.uri) {
      author.href = review.author.uri;
      author.target = '_blank';
      author.rel = 'noreferrer';
    }

    const published = article.querySelector<HTMLElement>(
      '[data-review-published]',
    )!;
    published.textContent = review.relativePublishTimeDescription ?? '';
    published.hidden = !review.relativePublishTimeDescription;
    article.querySelector<HTMLElement>('[data-review-date-separator]')!.hidden =
      !review.relativePublishTimeDescription;

    return article;
  };

  const renderDots = () => {
    if (!dots) return;
    dots.replaceChildren();
    getSlides().forEach((_, index) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.dataset.googleReviewsDot = '';
      dot.className =
        'size-2 rounded-full bg-white/40 transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary';
      dot.setAttribute('aria-label', `Visa recension ${index + 1}`);
      dot.addEventListener('click', () => showSlide(index));
      dots.append(dot);
    });
  };

  previous?.addEventListener('click', () => showSlide(activeIndex - 1));
  next?.addEventListener('click', () => showSlide(activeIndex + 1));
  dots
    ?.querySelectorAll<HTMLButtonElement>('[data-google-reviews-dot]')
    .forEach((dot) =>
      dot.addEventListener('click', () => showSlide(Number(dot.dataset.index))),
    );
  showSlide(0);

  const loadReviews = async () => {
    if (!section || !list || !rating || !reviewTemplate) return;
    try {
      const response = await fetch('/.netlify/functions/google-reviews');
      if (!response.ok) return;
      const data = (await response.json()) as GoogleReviewsResponse;
      if (!data.reviews?.length) return;
      if (typeof data.rating === 'number') {
        rating.textContent = data.rating.toFixed(1);
      }
      if (reviewCount && typeof data.userRatingCount === 'number') {
        reviewCount.textContent = `${data.userRatingCount} recensioner`;
      }
      list.replaceChildren(...data.reviews.map(createReviewCard));
      activeIndex = 0;
      renderDots();
      showSlide(0);
      section.hidden = false;
      requestParallaxUpdate();
    } catch {
      // The local placeholder remains visible when the function is unavailable.
    }
  };

  void loadReviews();
</script>

<style lang="scss">
  @use '../styles/variables' as *;

  .review-arrow {
    border: 0;
    background: transparent;
    transition: box-shadow $base-duration $standard-ease;

    &:is(:hover, :focus-visible) {
      box-shadow: $neon-shadow;
    }
  }
</style>
