---
import type { Location } from '../content/locations';

interface Props {
  location?: Location;
}

const { location } = Astro.props;
const menuId = `site-menu-${location?.id ?? 'landing'}`;
---

<div data-site-navigation>
  <button
    type="button"
    aria-label="Navigeringsmeny"
    aria-controls={menuId}
    aria-expanded="false"
    data-menu-toggle
    class="group relative z-70 h-8 w-8 cursor-pointer rounded-full transition-[background-color,opacity] duration-(--base-duration) ease-(--standard-ease)
    focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary md:h-9 md:w-9"
  >
    <span aria-hidden="true" class="absolute h-0.5 bg-current"></span>
    <span aria-hidden="true" class="absolute h-0.5 bg-current"></span>
    <span aria-hidden="true" class="absolute h-0.5 bg-current"></span>
  </button>

  <nav
    id={menuId}
    aria-label="Navigering"
    aria-hidden="true"
    data-site-menu
    class="group fixed inset-y-0 left-0 z-60 flex h-svh w-[min(22rem,85vw)] -translate-x-full flex-col bg-canvas/60 p-5 text-white shadow-2xl transition-transform duration-300 ease-out sm:p-8"
  >
    <button
      type="button"
      aria-label="Stäng navigeringsmeny"
      data-menu-close
      class="absolute right-5 top-5 h-8 w-8 cursor-pointer rounded-full opacity-0 transition-opacity duration-200 delay-200 ease-out focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary group-[.is-open]:opacity-100 sm:right-8 sm:top-8"
    >
      <span
        aria-hidden="true"
        class="absolute left-1/2 top-1/2 h-0.5 w-5 -translate-x-1/2 -translate-y-1/2 rotate-45 bg-current"
      ></span>
      <span
        aria-hidden="true"
        class="absolute left-1/2 top-1/2 h-0.5 w-5 -translate-x-1/2 -translate-y-1/2 -rotate-45 bg-current"
      ></span>
    </button>
    <ul class="mt-16 flex flex-col gap-6 text-3xl font-display uppercase">
      <li
        class="opacity-0 transition-opacity duration-200 delay-200 ease-out group-[.is-open]:opacity-100"
      >
        <a
          href="#menu-section"
          class="transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >Meny</a
        >
      </li>

      <li
        class="opacity-0 transition-opacity duration-200 delay-200 ease-out group-[.is-open]:opacity-100"
      >
        <a
          href="/"
          class="transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >Om oss</a
        >
      </li>
      <li
        class="opacity-0 transition-opacity duration-200 delay-200 ease-out group-[.is-open]:opacity-100"
      >
        <a
          href="/"
          class="pointer-events-none text-muted transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >Shop <span
            class="text-muted text-sm ml-2 font-sans italic normal-case"
            >Kommer snart...</span
          ></a
        >
      </li>
    </ul>
  </nav>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-site-navigation]')
    .forEach((navigation) => {
      const toggle =
        navigation.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = navigation.querySelector<HTMLElement>('[data-site-menu]');
      const close =
        navigation.querySelector<HTMLButtonElement>('[data-menu-close]');
      if (!toggle || !menu || !close) return;

      const setMenuOpen = (isOpen: boolean) => {
        menu.classList.toggle('-translate-x-full', !isOpen);
        menu.classList.toggle('is-open', isOpen);
        menu.setAttribute('aria-hidden', String(!isOpen));
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.setAttribute(
          'aria-label',
          isOpen ? 'Stäng navigeringsmeny' : 'Navigeringsmeny',
        );
        toggle.classList.toggle('pointer-events-none', isOpen);
        toggle.classList.toggle('opacity-0', isOpen);

        if (isOpen) {
          close.focus();
        } else {
          toggle.focus();
        }
      };

      toggle.addEventListener('click', () => {
        setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });

      close.addEventListener('click', () => setMenuOpen(false));

      menu
        .querySelector<HTMLAnchorElement>('a[href="#menu-section"]')
        ?.addEventListener('click', () => setMenuOpen(false));

      window.addEventListener('keydown', (event) => {
        if (
          event.key === 'Escape' &&
          toggle.getAttribute('aria-expanded') === 'true'
        ) {
          setMenuOpen(false);
        }
      });
    });
</script>

<style lang="scss">
  [data-menu-toggle] > span,
  [data-menu-close] > span {
    transition-property: transform, opacity, background-color;
    transition-duration: var(--base-duration);
    transition-timing-function: var(--standard-ease);
  }

  [data-menu-toggle] > span {
    top: 50%;
    left: 0;
    width: 100%;
    transform: translateY(-50%);
    transition-property: width, background-color;
  }

  [data-menu-toggle] > span:first-child {
    transform: translateY(calc(-50% - 0.5rem));
  }

  [data-menu-toggle] > span:nth-child(2) {
    width: 80%;
  }

  [data-menu-toggle] > span:last-child {
    width: 60%;
    transform: translateY(calc(-50% + 0.5rem));
  }

  [data-menu-toggle]:is(:hover, :focus-visible) > span {
    width: 100%;
  }

  [data-menu-toggle]:is(:hover, :focus-visible) > span,
  [data-menu-close]:is(:hover, :focus-visible) > span {
    background-color: var(--color-primary-light);
  }
</style>
