---
import type { Location } from '../content/locations';
interface Props {
  location: Location;
}
const { location } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-dark pt-28 text-sand sm:pt-32">
  <div class="page-shell grid gap-10 py-10 sm:grid-cols-2 sm:py-14">
    <div>
      <p class="font-display text-3xl leading-none">Piccola Nonna</p><p
        class="mt-3 max-w-sm text-sm leading-6 text-sand/80"
      >
        Små upplagor, goda råvaror och plats för alla.
      </p>
    </div><div class="sm:justify-self-end sm:text-right">
      <a
        href={location.instagramUrl}
        class="text-sm font-medium underline decoration-sand/50 underline-offset-4 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        target="_blank"
        rel="noreferrer">@{location.instagramHandle}</a
      ><p class="mt-5 text-xs text-sand/65">© {year} Piccola Nonna</p>
    </div>
  </div>
</footer>
