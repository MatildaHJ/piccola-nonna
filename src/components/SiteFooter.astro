---
import { cafeLocation, pizzaLocation } from '../content/locations';
import type { Location } from '../content/locations';
import NeonLogo from './NeonLogo.astro';

interface Props {
  location: Location;
}

const { location } = Astro.props;
---

<footer class="bg-canvas text-white">
  <div class="container">
    <div class="grid gap-10 py-10 xl:grid-cols-5 xl:gap-8 xl:py-14">
      <div class="xl:col-span-2">
        <NeonLogo
          src={location.assets.logo.src}
          class="h-30 w-30 md:w-30 md:h-30 z-30"
        />
        <p class="max-w-sm text-sm leading-6 text-muted mt-6">
          Handgjort med hyperfokus, kärlek och de finaste råvarorna. Varmt
          välkomna in!
        </p>
      </div>
      <section>
        <h2
          class="text-sm md:text-base font-medium uppercase tracking-[0.16em]"
        >
          Pizzeria
        </h2>
        <address class="mt-4 text-sm leading-6 text-muted not-italic">
          {pizzaLocation.address}<br />{pizzaLocation.locality}
        </address>
        <a
          href={pizzaLocation.instagramUrl}
          class="mt-4 inline-block break-all text-sm text-primary underline underline-offset-4 transition-colors hover:text-white
          focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          target="_blank"
          rel="noreferrer">@{pizzaLocation.instagramHandle}</a
        >
      </section>
      <section>
        <h2
          class="text-sm md:text-base font-medium uppercase tracking-[0.16em]"
        >
          Café
        </h2>
        <address class="mt-4 text-sm leading-6 text-muted not-italic">
          {cafeLocation.address}<br />{cafeLocation.locality}
        </address>
        <a
          href={cafeLocation.instagramUrl}
          class="mt-4 inline-block break-all text-sm text-primary underline underline-offset-4 transition-colors hover:text-white
          focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          target="_blank"
          rel="noreferrer">@{cafeLocation.instagramHandle}</a
        >
      </section>
      <section>
        <h2
          class="text-sm md:text-base font-medium uppercase tracking-[0.16em] mb-4"
        >
          Social
        </h2>
        <ul>
          <li>
            <a
              href="mailto:lapiccolanonna@gmail.com"
              class="text-sm leading-6 transition-colors hover:text-white
          focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
              >Facebook</a
            >
          </li>
          <li>
            <a
              href="mailto:lapiccolanonna@gmail.com"
              class="text-sm leading-6 transition-colors hover:text-white
          focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
              >Spotify</a
            >
          </li>
        </ul>

        <a
          href="mailto:lapiccolanonna@gmail.com"
          class="mt-4 inline-block text-sm leading-6 break-all text-primary underline underline-offset-4 transition-colors hover:text-white
          focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >lapiccolanonna@gmail.com</a
        >
      </section>
    </div>
    <div
      class="flex justify-between items-center py-8 text-muted text-xs border-t border-white/50"
    >
      <p>© 2026 La Piccola Nonna Stockholm. Anno 2019.</p>
      <p class="font-display text-primary tracking-wider">✦✦✦✦✦</p>
    </div>
  </div>
</footer>
