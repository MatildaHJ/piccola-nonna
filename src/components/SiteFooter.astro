---
import { cafeLocation, pizzaLocation } from '../content/locations';
import type { Location } from '../content/locations';

interface Props {
  location: Location;
}

const { location } = Astro.props;
---

<footer class="bg-canvas text-white">
  <div class="container">
    <div class="grid gap-10 py-10 xl:grid-cols-5 xl:gap-8 xl:py-14">
      <div class="xl:col-span-2">
        <img
          src={location.assets.logo.src}
          alt=""
          class="h-30 w-30 md:w-40 md:h-40 z-30"
          aria-hidden="true"
        />
      </div>
      <section>
        <h2
          class="text-sm md:text-base font-medium uppercase tracking-[0.16em] font-display text-primary"
        >
          Pizzeria
        </h2>
        <address class="mt-4 text-sm leading-6 text-muted not-italic">
          {pizzaLocation.address}<br />{pizzaLocation.locality}
        </address>
        <a
          href={pizzaLocation.instagramUrl}
          class="mt-4 inline-flex text-sm text-muted transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          target="_blank"
          rel="noreferrer">@{pizzaLocation.instagramHandle}</a
        >
      </section>
      <section>
        <h2
          class="text-sm md:text-base font-medium uppercase tracking-[0.16em] font-display text-primary"
        >
          Café
        </h2>
        <address class="mt-4 text-sm leading-6 text-muted not-italic">
          {cafeLocation.address}<br />{cafeLocation.locality}
        </address>
        <a
          href={cafeLocation.instagramUrl}
          class="mt-4 inline-flex text-sm text-muted transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          target="_blank"
          rel="noreferrer">@{cafeLocation.instagramHandle}</a
        >
      </section>
      <section>
        <h2
          class="text-sm md:text-base font-medium uppercase tracking-[0.16em] font-display text-primary"
        >
          Kontakt
        </h2>
        <p class="mt-4 max-w-sm text-sm leading-6 text-muted">
          Boka deg genom att komma förbi under våra öppettider. För övriga
          frågor maila
          <a
            href="mailto:lapiccolanonna@gmail.com"
            class="transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
            >lapiccolanonna@gmail.com</a
          >.
        </p>
      </section>
    </div>
    <div
      class="flex justify-between items-center py-8 text-muted text-xs border-t border-accent/50 mt-6 md:mt-8"
    >
      <p>© 2026 La Piccola Nonna Stockholm. Anno 2019.</p>
      <p class="font-display text-primary tracking-wider">✦✦✦✦✦</p>
    </div>
  </div>
</footer>
