---
import '../styles/app.css';
import LocationPage from '../components/LocationPage.astro';
import LocationSelector from '../components/LocationSelector.astro';
import { pizzaLocation } from '../content/locations';
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>Piccola Nonna Pizza · Södermalm</title>
  </head>
  <body class="bg-canvas text-ink">
    <LocationPage location={pizzaLocation} showSelector>
      <LocationSelector slot="selector" />
    </LocationPage>
  </body>
</html>
